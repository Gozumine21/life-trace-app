rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isFollowing(targetUserId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + targetUserId));
    }

    function isEventAuthor(eventId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/lifeEvents/$(eventId)).data.authorId == request.auth.uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'bulltop21@gmail.com';
    }

    // users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      // フォロー・フォロー解除では、相手のフォロワー数だけを増減する。
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount']);
      // アカウント削除時に、本人がプロフィールを削除する。
      allow delete: if isOwner(userId);

      match /notifications/{notificationId} {
        allow read, update: if isOwner(userId);
        allow create: if isSignedIn();
        allow delete: if isOwner(userId);
      }
    }

    // lifeEvents
    match /lifeEvents/{eventId} {
      // Listen(リアルタイム購読)クエリではOR条件によるper-document評価が
      // Emulator上で安定しないため、読み取りはサインイン済みなら許可し、
      // 公開範囲の絞り込みはクライアント側のクエリ（visibility/authorIdフィルタ）に委ねる。
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.authorId == request.auth.uid;
      // likeCount/commentCount は他ユーザーの操作（いいね・コメント）でも更新されるため、
      // 著者以外でも当該フィールドのみの増減更新は許可する。
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount']);
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
        // 記録の投稿者は、記録を削除するときに届いたコメントもまとめて削除できる。
        allow delete: if isEventAuthor(eventId);
      }

      match /reactions/{userId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isOwner(userId);
        allow delete: if isEventAuthor(eventId);
      }
    }

    // follows
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // experienceLogs
    match /experienceLogs/{logId} {
      // 読み取り・削除は保存済みの内容（resource）で、作成・更新は書き込む内容（request.resource）で判定する。
      // まだ存在しないドキュメントの get も、本人の履歴を作る前の確認として許可する。
      allow read: if isSignedIn() && (resource == null || resource.data.viewerId == request.auth.uid);
      allow create, update: if isSignedIn() && request.resource.data.viewerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.viewerId == request.auth.uid;
    }

    // blocks（ブロック機能：ブロックした本人のみ読み書き可能）
    match /blocks/{blockId} {
      allow read: if isSignedIn() && resource.data.blockerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.blockerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    // reports（通報機能：通報者は作成のみ、一覧の閲覧・対応は開発者のみ）
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update: if isAdmin();
      allow delete: if false;
    }
  }
}
